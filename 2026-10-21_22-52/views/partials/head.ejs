<%# Shared <head>. Locals: title (string), pageCss (optional file name in /css, without .css) %>
<%# ?v= changes on every server start, so browsers fetch fresh CSS/JS after an update despite the 1 h cache. %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<%# The app has its own light and dark themes (button in the top bar); this tells the Dark Reader extension not to recolour it. %>
<meta name="darkreader-lock">
<link rel="icon" href="data:,">

<title><%= title %> · سامانه‌ی پرونده‌ی بیماران</title>
<link rel="stylesheet" href="/css/tokens.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/base.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/components.css?v=<%= assetVersion %>">
<script type="module" src="/js/app.js?v=<%= assetVersion %>"></script>
<% if (typeof pageCss !== 'undefined' && pageCss) { %><link rel="stylesheet" href="/css/<%= pageCss %>.css?v=<%= assetVersion %>"><% } %>
