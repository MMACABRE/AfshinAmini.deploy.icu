# Copy this file to ".env" and fill it in. ".env" is never committed.

# The address people type to reach the site, with no https:// and no slash.
# It must already point at this server (an A record in your domain's DNS settings).
# For a test on your own computer use: localhost
DOMAIN=clinic.example.com

# Where the database, patient files and backups live. Must be outside the code folder on a server, so new
# versions of the code never touch it. On the server use: /opt/clinic-data/data  (default ./data is for testing).
DATA_PATH=./data

# Server time zone. The nightly backup runs at 03:00 in this zone.
# List of names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Tehran
